# =============================================================================
# HOMS PROJE — Environment variables (example only)
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

# --- HOMS AI ENGINE (hosting secrets only — never VITE_ prefix) -------------
HOMS_AI_PROVIDER=xai
# HOMS_AI_FALLBACK=xai

# Required when HOMS_AI_PROVIDER=xai
XAI_API_KEY=

# --- Staff / App gate -------------------------------------------------------
# REQUIRED in production. No fallback secret exists in source code.
# App unlock + stable homs_live_* key are derived from this value.
HOMS_STAFF_CODE=

# Optional extra API tokens (comma or space separated)
HOMS_LIVE_KEYS=

# --- API security (optional overrides) --------------------------------------
# Comma-separated allowed origins (defaults include homsproje.com)
# HOMS_API_ORIGINS=https://homsproje.com,https://www.homsproje.com
# Requests per minute per token (5-120, default 30)
# HOMS_API_RPM=30

# --- Media persistence (Stage-1 prepared, not yet required) -----------------
# none | r2 | s3 | blob  (default: none → data-URL / temporary URL fallback)
# HOMS_MEDIA_PROVIDER=none
# (Provider-specific credentials added only when a backend is chosen)

# --- Auth (Better Auth) -----------------------------------------------------
# Keep false until Stage-2 migration is complete.
VITE_AUTH_ENABLED=false

# --- Database (optional) ----------------------------------------------------
# When set, Neon is used instead of embedded PGLite.
# DATABASE_URL=
