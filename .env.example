# HOMS AI ENGINE — hosting secrets only. Never VITE_ prefix.
HOMS_AI_PROVIDER=xai
# HOMS_AI_FALLBACK=xai

# Active while HOMS_AI_PROVIDER=xai
XAI_API_KEY=

# App yönetici kodu (istemciye gömülmez)
HOMS_STAFF_CODE=

# İsteğe bağlı ekstra homs_live anahtarları, virgülle
HOMS_LIVE_KEYS=

# İsteğe bağlı
VITE_AUTH_ENABLED=false
