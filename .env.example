# =============================================================================
# HOMS PROJE — Environment variables (example only)
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

# --- HOMS AI ENGINE (hosting secrets only — never VITE_ prefix) -------------
HOMS_AI_PROVIDER=xai
# HOMS_AI_FALLBACK=xai

# Required when HOMS_AI_PROVIDER=xai
XAI_API_KEY=

# --- Staff / App gate -------------------------------------------------------
# REQUIRED in production. No fallback secret exists in source code.
HOMS_STAFF_CODE=

# Optional extra API tokens (comma or space separated)
HOMS_LIVE_KEYS=

# --- API security (optional overrides) --------------------------------------
# HOMS_API_ORIGINS=https://homsproje.com,https://www.homsproje.com
# HOMS_API_RPM=30

# --- Auth (Better Auth) -----------------------------------------------------
# Production: set to true and provide DATABASE_URL + BETTER_AUTH_SECRET.
VITE_AUTH_ENABLED=true
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://homsproje.com

# --- Database ---------------------------------------------------------------
# REQUIRED in production (NODE_ENV=production | VERCEL=1 | HOMS_REQUIRE_DATABASE=true).
# Without DATABASE_URL the process fails closed — PGLite is NOT used in production.
# DATABASE_URL=
# Force production DB policy in non-production hosts:
# HOMS_REQUIRE_DATABASE=true

# --- Media persistence (Cloudflare R2 / S3) ---------------------------------
# none | r2 | s3  (default: none → data-URL / temporary URL fallback)
# HOMS_MEDIA_PROVIDER=r2
# HOMS_MEDIA_BUCKET=
# HOMS_MEDIA_ACCESS_KEY_ID=
# HOMS_MEDIA_SECRET_ACCESS_KEY=
# HOMS_MEDIA_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# HOMS_MEDIA_PUBLIC_BASE_URL=https://media.example.com
# HOMS_MEDIA_REGION=auto
